# FlowCanva 环境变量配置
# 复制此文件为 .env 并修改

PORT=:6789
DB_PATH=./data.db
UPLOAD_DIR=./uploads
LOG_LEVEL=info

# 全局中转站兜底（节点未单独配置 API Key 时使用）
ZHENGAPI_BASE_URL=https://zhengapi.top
ZHENGAPI_API_KEY=
# true：视频参考图直接传 data URL；false：先上传到图床
ZHENGAPI_USE_DATA_URLS=true

# MegaBY 视频中转站（模型名以 megaby- 前缀区分 ZhengAPI）
MEGABY_BASE_URL=https://newapi.megabyai.cc
MEGABY_API_KEY=

# 图片模型专用中转站（图片节点未单独配置 API Key 时使用）
GEEKNOW_BASE_URL=https://www.geeknow.top
GEEKNOW_API_KEY=

# 阿里云 OSS 公共读素材图床
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=cn-beijing
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
